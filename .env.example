# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/roomkhojo

# Auth (JWT + Google). JWT_SECRET 32+ random chars ho:
# openssl rand -hex 32
JWT_SECRET=<paste-here>
GOOGLE_CLIENT_ID=<google-cloud-oauth-client-id>

# Pehla admin — sirf tab use hota hai jab DB me ZERO admins ho.
# Restart par reset NAHI hota.
# Recovery (password bhool jao toh): ADMIN_FORCE_RESET=true + naya
# ADMIN_INITIAL_PASSWORD set karke redeploy karo, login karo, phir
# flag hata kar dobara redeploy karo.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=<strong-password-here>
ADMIN_FORCE_RESET=false

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# Cloudinary (room photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP (password reset). Gmail App Password ya Resend.
# Ye set na ho toh forgot-password 503 dega (app crash nahi hogi).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 🚦 Rate-limit shared store (OPTIONAL — Vercel serverless ke liye recommended).
# Kisi EK style me values daalo (dono same Upstash REST hain):
# Style 1 — Upstash direct (console.upstash.com → Redis DB → REST API section):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Style 2 — Vercel KV / Marketplace integration style:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set na ho toh MemoryStore chalta hai (sab kaam karta hai, bas limit per-instance).
# Purana Upstash Redis kisi dusre project me lag chuka ho toh WAHI values yahan daal
# sakte ho — hamare keys 'rk:rl:' namespace me hain, collision nahi hoga.

# ⏰ Promo/banner expiry cron (OPTIONAL). Vercel → Settings → Env me daalo toh cron
# endpoint sirf Vercel ke request (Authorization header) se chalta hai. Bina iske bhi
# cron chalta hai — operation harmless/idempotent hai (sirf beeti hui expiry flip karta hai).
CRON_SECRET=
