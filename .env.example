# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/roomkhojo

# Auth (JWT + Google). JWT_SECRET 32+ random chars ho:
# openssl rand -hex 32
JWT_SECRET=<paste-here>
GOOGLE_CLIENT_ID=<google-cloud-oauth-client-id>

# Pehla admin — sirf tab use hota hai jab DB me ZERO admins ho.
# Restart par reset NAHI hota.
# Recovery (password bhool jao toh): ADMIN_FORCE_RESET=true + naya
# ADMIN_INITIAL_PASSWORD set karke redeploy karo, login karo, phir
# flag hata kar dobara redeploy karo.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=<strong-password-here>
ADMIN_FORCE_RESET=false

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# Cloudinary (room photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP (password reset). Gmail App Password ya Resend.
# Ye set na ho toh forgot-password 503 dega (app crash nahi hogi).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
